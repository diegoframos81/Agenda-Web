# Variáveis de Ambiente - Agenda-Web
# Copie este arquivo para .env e ajuste os valores

# ===== BANCO DE DADOS =====
MONGODB_URI=mongodb://localhost:27017/agendaweb

# ===== BACKEND API =====
NODE_ENV=development
PORT=4000

# ===== AUTENTICAÇÃO =====
# IMPORTANTE: Altere este secret em produção!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===== ADMIN PADRÃO =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=superadmin123

# ===== DOCKER =====
# Descomentar se usar Docker Compose
# MONGODB_URI=mongodb://mongodb:27017/agendaweb
# API_URL=http://backend:4000
